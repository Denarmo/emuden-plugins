+    if (crosses_50_60 || std::fabs(info.timing.fps - Libretro::s_frontend_fps) > 1.0)
+    {
       Libretro::environ_cb(RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO, &info);
