   perf_cb.perf_log();
 #endif
@@ -230,10 +234,15 @@ void retro_get_system_av_info(retro_system_av_info* info)
     info->geometry.aspect_ratio *= 2.0;
 
   Core::System& system = Core::System::GetInstance();
+  // Until the game first programs the VI, its registers hold Dolphin's boot preset, whose
+  // timing at the 54 MHz clock of an NTSC console is 119.88 fields a second, twice what
+  // any game runs at. The region's rate stands in for it until then.
   double fps = system.GetVideoInterface().GetTargetRefreshRate();
