+    if (cmd == RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO)
+      Libretro::s_frontend_fps = info.timing.fps;
   }
 
   if (Libretro::Options::IsUpdated(Libretro::Options::gfx_settings::CROP_OVERSCAN))
@@ -415,9 +426,6 @@ void retro_run(void)
