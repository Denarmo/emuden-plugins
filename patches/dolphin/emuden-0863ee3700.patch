@@ -425,8 +433,16 @@ void retro_run(void)
       Libretro::s_refresh_rate_settled && ((old_rate > 55.0) != (new_rate > 55.0));
     Libretro::s_refresh_rate_settled = true;
 
-    if (crosses_50_60)
+    retro_system_av_info info;
+    retro_get_system_av_info(&info);
+
+    // retro_run returns once per field, so a frontend pacing by a rate that is off by
