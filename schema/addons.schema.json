{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmuDEN add-on catalogue (addons.json)",
  "type": "object",
  "required": ["catalogue_version", "titles", "addons"],
  "properties": {
    "catalogue_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "titles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["program_id", "name"],
        "properties": {
          "program_id": { "$ref": "#/$defs/program_id" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "program_id", "needs", "layer_types", "package"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}$" },
          "summary": { "type": "string" },
          "authors": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "program_id": { "$ref": "#/$defs/program_id" },
          "game_versions": { "type": "array", "items": { "type": "string" } },
          "build_ids": { "type": "array", "items": { "type": "string", "pattern": "^[0-9A-Fa-f]{40,64}$" } },
          "needs": { "type": "array", "items": { "type": "string" } },
          "layer_types": { "type": "array", "items": { "enum": ["nso-patch", "transform", "exefs", "romfs", "romfslite", "romfs_ext", "cheats"] } },
          "package": {
            "type": "object",
            "required": ["url", "sha256", "size"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 }
            }
          },
          "icon": { "type": "string" },
          "screenshots": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "program_id": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
  }
}
