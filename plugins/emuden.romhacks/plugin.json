{
  "manifest_version": 1,
  "id": "emuden.romhacks",
  "name": "ROM Hacks: hackdex.app",
  "version": "2.0.2",
  "kind": "feature",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "Browse hackdex.app inside EmuDEN and install the patches you download on your own games.",
  "api": 1,
  "needs": [
    "kind.feature",
    "feature.lua.1",
    "feature.web.1"
  ],
  "platforms": [
    "any"
  ],
  "feature": {
    "entry": "main.lua",
    "icon": "icon.png",
    "permissions": [
      "browse",
      "files.import",
      "library.read",
      "patch",
      "library.write"
    ],
    "browse_hosts": [
      "www.hackdex.app",
      "hackdex.app",
      "patches.hackdex.app"
    ],
    "file_types": [
      "bps",
      "ips",
      "ups",
      "xdelta",
      "vcdiff",
      "aps",
      "ppf"
    ],
    "systems": [
      "gb",
      "gbc",
      "gba",
      "nds"
    ]
  }
}
