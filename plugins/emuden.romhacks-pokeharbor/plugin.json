{
  "manifest_version": 1,
  "id": "emuden.romhacks-pokeharbor",
  "name": "ROM Hacks: pokeharbor.com",
  "version": "1.0.0",
  "kind": "feature",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "Browse pokeharbor.com inside EmuDEN. The site mostly offers already patched games, which EmuDEN refuses: only patch files are installed.",
  "api": 1,
  "needs": [
    "kind.feature",
    "feature.lua.1",
    "feature.web.1"
  ],
  "platforms": [
    "any"
  ],
  "feature": {
    "entry": "main.lua",
    "icon": "icon.png",
    "permissions": [
      "browse",
      "files.import",
      "library.read",
      "patch",
      "library.write"
    ],
    "browse_hosts": [
      "www.pokeharbor.com",
      "pokeharbor.com"
    ],
    "file_types": [
      "bps",
      "ips",
      "ups",
      "xdelta",
      "vcdiff",
      "aps",
      "ppf"
    ],
    "systems": [
      "gb",
      "gbc",
      "gba",
      "nds"
    ]
  }
}
