{
  "manifest_version": 1,
  "id": "emuden.ps2",
  "name": "PlayStation 2",
  "version": "1.2.4",
  "kind": "console",
  "engine": "libretro",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "PlayStation 2 games with DenSX2, which needs no BIOS. DenSX2 is based on Play! (BSD-2-Clause).",
  "api": 1,
  "needs": [
    "engine.libretro"
  ],
  "platforms": [
    "any"
  ],
  "systems": [
    {
      "id": "ps2",
      "name": "PlayStation 2",
      "group": "sony",
      "order": 1700,
      "content": {
        "extensions": [
          "iso",
          "chd",
          "cso"
        ],
        "folder_aliases": [
          "playstation2"
        ],
        "zip": "unpack"
      },
      "presentation": {
        "cover_aspect": 0.71,
        "handheld": false,
        "right_stick_holds": false,
        "native_size": [
          640,
          448
        ],
        "layout": "other",
        "digital_only": false,
        "media": {
          "shape": "case",
          "aspect": 0.7,
          "disc": true
