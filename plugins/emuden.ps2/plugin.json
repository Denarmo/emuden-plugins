      "achievements": {
        "rcheevos_console": 21
      },
      "cores": [
        "densx2",
        "psx2-ecp"
      ],
      "bios": [
        {
          "label": "PlayStation 2 BIOS",
          "any_one": false,
          "files": [
            {
              "path": "pcsx2/bios/",
              "optional": false
            }
          ],
          "cores": [
            "psx2-ecp"
          ]
        }
      ],
      "default_core": "densx2"
    }
  ],
