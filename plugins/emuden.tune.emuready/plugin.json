{
  "manifest_version": 1,
  "id": "emuden.tune.emuready",
  "name": "Tune: EmuReady",
  "version": "1.0.1",
  "kind": "feature",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "Sets a game up from EmuReady listings of devices like yours (the same device, the same chip, then similar graphics): resolution, renderer and frame skip for the core EmuDEN uses, for that game only, after you agree. Undo puts them back.",
  "api": 1,
  "needs": [
    "kind.feature",
    "feature.lua.1",
    "feature.tune.1"
  ],
  "platforms": [
    "any"
  ],
  "feature": {
    "entry": "main.lua",
    "icon": "icon.png",
    "permissions": [
      "http",
      "device.info",
      "library.read",
      "game.settings"
    ],
    "http": {
      "hosts": [
        "www.emuready.com"
      ],
      "min_interval_ms": 1000
    },
    "systems": [
      "ps2",
      "psp",
      "psx",
      "nds",
      "n64",
      "gamecube",
      "wii",
      "dreamcast",
      "saturn"
    ],
    "limits": {
      "memory_mb": 32
    }
  }
}
