{
  "manifest_version": 1,
  "id": "emuden.switch2",
  "name": "Nintendo Switch 2 and Switch",
  "version": "1.1.0",
  "kind": "console",
  "engine": "switch2",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "Switch 2 and Switch games with DenNX, EmuDEN's own engine, downloaded like a core. Decrypted dumps only; no firmware or keys.",
  "api": 1,
  "needs": [
    "engine.switch2",
    "settings.v1"
  ],
  "platforms": [
    "windows-x86_64",
    "linux-x86_64"
  ],
  "systems": [
    {
      "id": "switch2",
      "name": "Nintendo Switch 2",
      "short_name": "Switch 2",
      "group": "nintendo",
      "order": 0,
      "content": {
        "extensions": [
          "nup"
        ],
        "scanner": "switch2",
        "folder_aliases": [
          "switch 2",
          "ns2",
          "nx2",
          "nintendo switch 2",
          "nintendoswitch2"
        ],
        "zip": "no"
      },
      "artwork": {
        "launchbox": "Nintendo Switch 2"
      },
      "presentation": {
        "cover_aspect": 1.0,
        "handheld": false,
        "right_stick_holds": false,
        "layout": "other",
        "digital_only": false,
        "media": {
          "shape": "card",
          "aspect": 0.68
        }
      }
    },
    {
      "id": "switch",
      "name": "Nintendo Switch",
      "short_name": "Switch",
      "group": "nintendo",
      "order": 1,
      "content": {
        "extensions": [
          "nsp",
          "xci"
        ],
        "scanner": "switch2",
        "folder_aliases": [
          "switch",
          "ns",
          "nx",
          "nintendo switch",
          "nintendoswitch"
        ],
        "zip": "no"
      },
      "artwork": {
        "launchbox": "Nintendo Switch"
      },
      "presentation": {
        "cover_aspect": 1.0,
        "handheld": false,
        "right_stick_holds": false,
        "layout": "other",
        "digital_only": false,
        "media": {
          "shape": "cartridge",
          "style": "switch"
        }
      }
    }
  ],
  "components": [
    {
      "id": "nx2",
      "type": "engine",
      "name": "DenNX",
      "license": "GPL-3.0-or-later",
      "homepage": "https://github.com/Denarmo/DenNX",
      "delivery": {
        "windows-x86_64": "download",
        "linux-x86_64": "download"
      },
      "executable": {
        "windows-x86_64": "bin/emuden-switch2.exe",
        "linux-x86_64": "bin/emuden-switch2"
      }
    }
  ],
  "capabilities": {
    "addons": true
  },
  "settings": [
    {
      "key": "resolution",
      "section": "Graphics",
      "type": "choice",
      "scope": "game",
      "apply": {
        "native_setting": "resolution_setup"
      }
    },
    {
      "key": "scaling_filter",
      "section": "Graphics",
      "type": "choice",
      "scope": "game",
      "apply": {
        "native_setting": "scaling_filter"
      }
    },
    {
      "key": "anti_aliasing",
      "section": "Graphics",
      "type": "choice",
      "scope": "game",
      "apply": {
        "native_setting": "anti_aliasing"
      }
    },
    {
      "key": "aspect_ratio",
      "section": "Graphics",
      "type": "choice",
      "scope": "game",
      "apply": {
        "native_setting": "aspect_ratio"
      }
    },
    {
      "key": "frame_limit",
      "section": "Graphics",
      "type": "range",
      "scope": "game",
      "apply": {
        "native_setting": "nx2_frame_rate_limit"
      }
    },
    {
      "key": "texture_quality",
      "section": "Graphics",
      "type": "choice",
      "scope": "game",
      "apply": {
        "native_setting": "renderer.texture_quality"
      }
    },
    {
      "key": "fsr_upscaling",
      "section": "Graphics",
      "type": "choice",
      "scope": "game",
      "apply": {
        "native_setting": "renderer.fsr_upscaling"
      }
    },
    {
      "key": "fsr_frame_gen",
      "section": "Graphics",
      "type": "toggle",
      "scope": "game",
      "apply": {
        "native_setting": "renderer.fsr_frame_gen"
      }
    },
    {
      "key": "docked",
      "section": "System",
      "type": "toggle",
      "scope": "game",
      "apply": {
        "native_setting": "use_docked_mode"
      }
    },
    {
      "key": "language",
      "section": "System",
      "type": "choice",
      "scope": "console",
      "apply": {
        "native_setting": "language_index"
      }
    },
    {
      "key": "region",
      "section": "System",
      "type": "choice",
      "scope": "console",
      "apply": {
        "native_setting": "region_index"
      }
    }
  ],
  "sync": {
    "saves": true,
    "settings": true
  }
}
