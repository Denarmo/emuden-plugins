{
  "manifest_version": 1,
  "id": "emuden.romhacks-romhacking",
  "name": "ROM Hacks: romhacking.net",
  "version": "1.0.1",
  "kind": "feature",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "Browse romhacking.net inside EmuDEN and install the patches you download on your own games.",
  "api": 1,
  "needs": [
    "kind.feature",
    "feature.lua.1",
    "feature.web.1"
  ],
  "platforms": [
    "any"
  ],
  "feature": {
    "entry": "main.lua",
    "icon": "icon.png",
    "permissions": [
      "browse",
      "files.import",
      "library.read",
      "patch",
      "library.write"
    ],
    "browse_hosts": [
      "www.romhacking.net",
      "romhacking.net",
      "archive.org",
      "www.archive.org"
    ],
    "file_types": [
      "bps",
      "ips",
      "ups",
      "xdelta",
      "vcdiff",
      "aps",
      "ppf"
    ],
    "systems": [
      "nes",
      "snes",
      "n64",
      "gb",
      "gbc",
      "gba",
      "nds",
      "genesis",
      "sms",
      "gg",
      "psx",
      "ps2",
      "psp",
      "saturn",
      "dreamcast"
    ]
  }
}
