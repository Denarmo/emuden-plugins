{
  "manifest_version": 1,
  "id": "emuden.list",
  "name": "List",
  "version": "1.0.0",
  "kind": "interface",
  "publisher": "EmuDEN",
  "license": "GPL-3.0-or-later",
  "summary": "Your games as a clear list of names with their console, when you last played and for how long, and the chosen game's cover large beside it.",
  "api": 1,
  "needs": [
    "kind.interface",
    "interface.1"
  ],
  "platforms": [
    "any"
  ],
  "interface": {
    "layout": "list",
    "icon": "icon.png",
    "colors": {
      "background": "#111214",
      "text": "#f2f1ee",
      "dim": "#a3a29c",
      "accent": "#f2b84b",
      "panel": "#ffffff17"
    },
    "backdrop": {
      "art": "console",
      "tint": 0.18
    },
    "covers": {
      "speed": 14
    },
    "list": {
      "rows": 9,
      "art": true,
      "art_side": "right",
      "thumbnails": true
    },
    "tabs": {
      "continue": true,
      "recent": true,
      "all": true
    },
    "launch": {
      "animation": "zoom",
      "seconds": 0.32
    },
    "consoles": {
      "continue": {
        "color": "#2f9e72"
      },
      "*": {
        "color": "#5b6178"
      },
      "recent": {
        "color": "#d8892b"
      },
      "all": {
        "color": "#4d6a8f"
      },
      "group:nintendo": {
        "color": "#c8323c"
      },
      "group:sony": {
        "color": "#3557a6"
      },
      "group:sega": {
        "color": "#2a6fc0"
      },
      "group:atari": {
        "color": "#a8562a"
      },
      "group:snk": {
        "color": "#b5892a"
      },
      "group:nec": {
        "color": "#7a4bb0"
      },
      "group:bandai": {
        "color": "#3f8c8a"
      },
      "group:arcade": {
        "color": "#b03a7a"
      },
      "group:other": {
        "color": "#5f7f4a"
      },
      "gb": {
        "color": "#6e8a3c",
        "label": "GB"
      },
      "gbc": {
        "color": "#8a46a8",
        "label": "GBC"
      },
      "gba": {
        "color": "#5440a6",
        "label": "GBA"
      },
      "nds": {
        "color": "#7d8492",
        "label": "DS"
      },
      "nes": {
        "color": "#b23a3a",
        "label": "NES"
      },
      "snes": {
        "color": "#6c5aa8",
        "label": "SNES"
      },
      "n64": {
        "color": "#2f8a4e",
        "label": "N64"
      },
      "gamecube": {
        "color": "#5a4aa0",
        "label": "GC"
      },
      "wii": {
        "color": "#4f9fc4",
        "label": "Wii"
      },
      "switch2": {
        "color": "#d43a3a"
      },
      "genesis": {
        "color": "#30343e",
        "label": "Genesis"
      },
      "sms": {
        "color": "#2d5fae",
        "label": "SMS"
      },
      "gg": {
        "color": "#3a3f8e",
        "label": "GG"
      },
      "saturn": {
        "color": "#4b5363",
        "label": "Saturn"
      },
      "dreamcast": {
        "color": "#d06a2a",
        "label": "DC"
      },
      "psx": {
        "color": "#6b7280",
        "label": "PS1"
      },
      "ps2": {
        "color": "#24366e",
        "label": "PS2"
      },
      "psp": {
        "color": "#3a3a48",
        "label": "PSP"
      }
    }
  }
}
